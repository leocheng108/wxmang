{
  "name": "bizfind-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "类 Google 的企业业务检索引擎演示：TypeScript + Node.js + Solr 适配层",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/start/index.js",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --pool=threads",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "commit": "node scripts/auto-commit.mjs",
    "reset": "node scripts/reset-demo.mjs",
    "reindex": "node scripts/reindex-core.mjs",
    "notes:ensure": "node scripts/ensure-notes-solr.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-demo.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
